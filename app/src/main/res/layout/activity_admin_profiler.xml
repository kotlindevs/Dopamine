<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    tools:context=".activities.AdminProfiler">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/adminImageIc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/adminImage"
            android:layout_width="256dp"
            android:layout_height="256dp"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/adminProfile"/>
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adminProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/adminImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/adminLoginDetails">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/adminName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textStyle="bold"
            android:layout_margin="2dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/adminEmail"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/adminEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_margin="2dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/adminName"
            app:layout_constraintBottom_toTopOf="@id/adminDescription"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/adminDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_margin="6dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/adminEmail"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adminLoginDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/adminProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/adminLogin">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutAdminId"
            android:layout_width="252dp"
            android:layout_height="wrap_content"
            android:hint="@string/administrator_id"
            android:layout_marginBottom="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/textInputLayoutPasswd">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/adminId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutPasswd"
            android:layout_width="252dp"
            android:layout_height="wrap_content"
            android:hint="@string/password"
            android:layout_marginTop="3dp"
            app:endIconMode="password_toggle"
            app:layout_constraintTop_toBottomOf="@id/textInputLayoutAdminId"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/adminPasswd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"/>
        </com.google.android.material.textfield.TextInputLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/rememberAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/save_this_device"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/adminLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sign_in"
        android:layout_margin="16dp"
        android:visibility="gone"
        style="@style/Widget.Material3.Button.TonalButton.Icon"
        app:icon="@drawable/login"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium"
        app:layout_constraintTop_toBottomOf="@id/adminLoginDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/findUserImage"
        android:layout_width="312dp"
        android:layout_height="512dp"
        android:visibility="gone"
        android:src="@drawable/find_user" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/findUserText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:visibility="gone"
        android:text="@string/we_are_getting_the_data_from_the_server"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/findUserDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_margin="6dp"
        android:visibility="gone"
        android:text="@string/wait_a_moment"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
</LinearLayout>