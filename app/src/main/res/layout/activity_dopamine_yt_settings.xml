<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.DopamineYtSettings">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:title="Settings"
            app:navigationIcon="@drawable/back_press"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/appearance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorPrimary"
                android:text="@string/appearance"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/useSystemColorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/system_theme_color"
                android:layout_marginStart="12dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/useSystemColor"
                app:layout_constraintEnd_toStartOf="@id/useSystemColor"
                app:layout_constraintBottom_toTopOf="@id/textUseSystemColorDesc"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textUseSystemColorDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/available_in_android_12_and_above"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                app:layout_constraintTop_toBottomOf="@id/useSystemColorText"
                app:layout_constraintStart_toStartOf="@id/useSystemColorText"
                app:layout_constraintBottom_toBottomOf="@id/useSystemColor"
                app:layout_constraintEnd_toStartOf="@id/useSystemColor" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/useSystemColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/useSystemColorText"
                app:layout_constraintTop_toBottomOf="@id/appearance"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/useSystemTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/current_theme"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/textUseSystemColorDesc"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/useSystemThemeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                app:layout_constraintTop_toBottomOf="@id/useSystemTheme"
                app:layout_constraintStart_toStartOf="@id/useSystemTheme"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/experimentalFeatures"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorPrimary"
                android:text="@string/experimental_features"
                app:layout_constraintTop_toBottomOf="@id/useSystemThemeText"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/useLiveSearchText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/use_live_search"
                android:layout_marginStart="12dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/useLiveSearch"
                app:layout_constraintEnd_toStartOf="@id/useLiveSearch"
                app:layout_constraintBottom_toTopOf="@id/textLiveSearchDesc"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textLiveSearchDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/get_unlimited_search_results"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                app:layout_constraintTop_toBottomOf="@id/useLiveSearchText"
                app:layout_constraintStart_toStartOf="@id/useLiveSearchText"
                app:layout_constraintBottom_toBottomOf="@id/useLiveSearch"
                app:layout_constraintEnd_toStartOf="@id/useLiveSearch" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/useLiveSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/useLiveSearchText"
                app:layout_constraintTop_toBottomOf="@id/experimentalFeatures"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/installPreReleaseUpdateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/install_pre_release_update"
                android:layout_marginStart="12dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/installPreReleaseUpdate"
                app:layout_constraintEnd_toStartOf="@id/installPreReleaseUpdate"
                app:layout_constraintBottom_toTopOf="@id/textInstallPreReleaseUpdateDesc"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textInstallPreReleaseUpdateDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/use_beta_updates_to_improve_your_experience"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                app:layout_constraintTop_toBottomOf="@id/installPreReleaseUpdateText"
                app:layout_constraintStart_toStartOf="@id/installPreReleaseUpdateText"
                app:layout_constraintBottom_toBottomOf="@id/installPreReleaseUpdate"
                app:layout_constraintEnd_toStartOf="@id/installPreReleaseUpdate" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/installPreReleaseUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/installPreReleaseUpdateText"
                app:layout_constraintTop_toBottomOf="@id/useLiveSearch"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tryVideoStreaming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stream_video"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/installPreReleaseUpdate"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tryVideoStreamingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/copy_paste_your_link_and_watch_any_video_free"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                app:layout_constraintTop_toBottomOf="@id/tryVideoStreaming"
                app:layout_constraintStart_toStartOf="@id/tryVideoStreaming"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tryVideoDownloading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_any_video"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tryVideoStreamingText"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tryVideoDownloadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_videos_are_available_for_download"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                app:layout_constraintTop_toBottomOf="@id/tryVideoDownloading"
                app:layout_constraintStart_toStartOf="@id/tryVideoDownloading"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/options"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorPrimary"
                android:text="@string/options"
                app:layout_constraintTop_toBottomOf="@id/tryVideoDownloadingText"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/managePlaylists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/manage_playlists"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/options"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/managePlaylistsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/you_can_customize_your_playlists_here"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                app:layout_constraintTop_toBottomOf="@id/managePlaylists"
                app:layout_constraintStart_toStartOf="@id/managePlaylists"/>


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/currentRegion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/current_region"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/managePlaylistsText"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/currentRegionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/your_home_region"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                app:layout_constraintTop_toBottomOf="@id/currentRegion"
                app:layout_constraintStart_toStartOf="@id/currentRegion"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/googleSignOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sign_out"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/currentRegionText"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/googleSignOutText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/you_will_be_signed_out_from_dopamine"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                app:layout_constraintTop_toBottomOf="@id/googleSignOut"
                app:layout_constraintStart_toStartOf="@id/googleSignOut"/>


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/aboutUs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorPrimary"
                android:text="@string/about_us"
                app:layout_constraintTop_toBottomOf="@id/googleSignOutText"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/viewAboutUs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_dopamine"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/aboutUs"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/viewAboutUsDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/you_can_view_more_about_dopamine_here"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                app:layout_constraintTop_toBottomOf="@id/viewAboutUs"
                app:layout_constraintStart_toStartOf="@id/viewAboutUs"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/viewAboutDeveloper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_developer"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/viewAboutUsDesc"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/viewAboutDeveloperDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/developed_by_me"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                app:layout_constraintTop_toBottomOf="@id/viewAboutDeveloper"
                app:layout_constraintStart_toStartOf="@id/viewAboutDeveloper"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkForUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/check_for_updates"
                android:layout_marginTop="16dp"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                app:icon="@drawable/ic_update"
                app:layout_constraintTop_toBottomOf="@id/viewAboutDeveloperDesc"
                app:layout_constraintStart_toStartOf="@id/viewAboutDeveloperDesc" />
            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/checkForUpdate"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

</androidx.constraintlayout.widget.ConstraintLayout>