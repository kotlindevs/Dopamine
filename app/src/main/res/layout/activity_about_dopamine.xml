<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".activities.AboutDopamine">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:visibility="gone"
            app:title="About Dopamine"
            app:navigationIcon="@drawable/back_press" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="?attr/colorPrimaryContainer"
            android:visibility="gone"
            style="@style/Widget.Material3.CardView.Filled"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_dopamine"
                android:layout_margin="12dp"
                android:tint="?attr/colorOnPrimaryContainer"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/dopamine_title"
            android:textStyle="bold"
            android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            app:layout_constraintStart_toEndOf="@id/card"
            app:layout_constraintTop_toTopOf="@id/card"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:textStyle="normal"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:maxLines="4"
            android:text="@string/dopamine_description"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/card"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/build"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/build"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            app:layout_constraintTop_toBottomOf="@id/card"
            app:layout_constraintStart_toStartOf="@id/card"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/buildVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            app:layout_constraintTop_toBottomOf="@id/build"
            app:layout_constraintStart_toStartOf="@id/build" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/buildVersion"
            app:layout_constraintStart_toStartOf="@id/buildVersion"/>

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/versionDivider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/version"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/buildRelease"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/release"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            app:layout_constraintTop_toBottomOf="@id/versionDivider"
            app:layout_constraintStart_toStartOf="@id/build" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/release"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/release"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/buildRelease"
            app:layout_constraintStart_toStartOf="@id/buildRelease"/>

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/releaseDivider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/release"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/buildCompileTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/compile_time"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            app:layout_constraintTop_toBottomOf="@id/releaseDivider"
            app:layout_constraintStart_toStartOf="@id/build" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/compileTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/compile_time"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/buildCompileTime"
            app:layout_constraintStart_toStartOf="@id/buildCompileTime"/>


        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/os"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/android_system"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            app:layout_constraintTop_toBottomOf="@id/compileTime"
            app:layout_constraintStart_toStartOf="@id/card"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/currentAndroidVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/android_version"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            app:layout_constraintTop_toBottomOf="@id/os"
            app:layout_constraintStart_toStartOf="@id/os" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/androidVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/android_version"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/currentAndroidVersion"
            app:layout_constraintStart_toStartOf="@id/currentAndroidVersion"/>

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/androidVersionDivider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/androidVersion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/systemUpdateStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_status"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            app:layout_constraintTop_toBottomOf="@id/androidVersionDivider"
            app:layout_constraintStart_toStartOf="@id/os" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/updateStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_status"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/systemUpdateStatus"
            app:layout_constraintStart_toStartOf="@id/systemUpdateStatus"/>


        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/company"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/company"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            app:layout_constraintEnd_toEndOf="@id/developer"
            app:layout_constraintStart_toStartOf="@id/developer"
            app:layout_constraintBottom_toTopOf="@id/developer"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/developer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/developed_by_me"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/updateStatus"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/dopamineTeamImage"
            android:layout_width="352dp"
            android:layout_height="352dp"
            android:src="@drawable/dopamine_team"
            android:layout_marginBottom="128dp"
            android:visibility="gone"
            android:layout_margin="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/dopamineTeamText1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_internet_connection"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/dopamineTeamImage"
            app:layout_constraintStart_toStartOf="@id/dopamineTeamImage"
            app:layout_constraintEnd_toEndOf="@id/dopamineTeamImage"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/dopamineTeamText2"
            android:layout_width="372dp"
            android:layout_height="wrap_content"
            android:text="@string/you_are_not_connected_to_the_internet_please_check_your_connection_and_try_again"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textStyle="normal"
            android:textAlignment="center"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/dopamineTeamText1"
            app:layout_constraintStart_toStartOf="@id/dopamineTeamText1"
            app:layout_constraintEnd_toEndOf="@id/dopamineTeamText1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>